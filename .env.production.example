# ===========================================================================
# PRODUCTION CONFIGURATION
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# .env.production holds real credentials. Never commit it. Never paste it into
# a ticket or a chat.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. SECRETS  -- generate these, do not invent them by hand
#
#    openssl rand -base64 48        (APP_SECRET)
#    openssl rand -base64 32        (the two passwords)
# ---------------------------------------------------------------------------
APP_SECRET=
APP_DB_USER=bi_app
APP_DB_PASSWORD=
APP_DB_NAME=bi_metadata
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# 2. OPERATIONAL DATABASE  (read-only -- this is your live business database)
#
#    Use a dedicated SELECT-only role. The application performs a write probe
#    at startup and REFUSES TO BOOT if this connection can write.
#    The CREATE ROLE statements are in ARCHITECTURE.md, section D/L1.
#
#    Point at a read replica if you have one, and set DATABASE_IS_REPLICA=true.
# ---------------------------------------------------------------------------
DATA_SOURCE_MODE=live
DATABASE_TYPE=postgresql
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=bi_readonly
DATABASE_PASSWORD=
DATABASE_SSL=require
DATABASE_ENFORCE_READ_ONLY=true
DATABASE_IS_REPLICA=false

# If the operational database runs on the Docker host itself rather than a
# separate machine, use the host gateway rather than localhost -- inside a
# container, localhost is the container:
#   DATABASE_HOST=host.docker.internal
# and add to the api service in docker-compose.prod.yml:
#   extra_hosts: ["host.docker.internal:host-gateway"]

# ---------------------------------------------------------------------------
# 3. NETWORK
# ---------------------------------------------------------------------------
# The address users will type. Used for CORS and for cookie policy.
#
# If this starts with https:// the session cookie is marked Secure. If it starts
# with http:// it is not -- because a Secure cookie sent over plain HTTP is
# silently discarded by the browser, which looks to the user like sign-in
# failing and bouncing back to the login page.
#
# Set SESSION_COOKIE_SECURE=true/false only to override that inference, for
# example when TLS is terminated by a proxy in front of this stack.
PUBLIC_ORIGIN=http://bi.internal
SESSION_COOKIE_SECURE=
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------
# 4. CAPACITY
#
# WEB_CONCURRENCY is backend worker processes. Each holds its own connection
# pool (5 + 5 overflow) to the operational database, so total connections are
# roughly WEB_CONCURRENCY x 10. Keep that well under the database's max
# connections -- reporting must never starve the business application.
# ---------------------------------------------------------------------------
WEB_CONCURRENCY=4
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=50000

# ---------------------------------------------------------------------------
# 5. AI  (Phase 7 -- the platform is fully functional with this off)
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
