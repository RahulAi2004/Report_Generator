# =============================================================================
# Copy to .env and fill in. NEVER commit .env.
# .env holds real credentials; .env.example must never contain any.
# =============================================================================

# -----------------------------------------------------------------------------
# OPERATIONAL DATABASE (read-only) -- the centralized business database.
#
# The application connects to this with SELECT-ONLY privileges and refuses to
# start if it detects write access. Point at a READ REPLICA when one exists.
# -----------------------------------------------------------------------------
DATABASE_TYPE=postgresql
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=prefer
# disable | allow | prefer | require | verify-ca | verify-full

# Set true once a dedicated read-only role exists. The startup self-test
# verifies this claim by attempting a rolled-back write; a mismatch is fatal.
DATABASE_ENFORCE_READ_ONLY=true
DATABASE_IS_REPLICA=false

# -----------------------------------------------------------------------------
# APPLICATION METADATA DATABASE (read-write) -- owned by this application.
# Separate instance. Never place application data in the operational database.
# -----------------------------------------------------------------------------
APP_DATABASE_URL=postgresql://bi_app:CHANGE_ME@localhost:5433/bi_metadata

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# QUERY GOVERNOR -- protects the production database (spec section 2)
# -----------------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=50000
QUERY_MAX_JOINS=8
QUERY_MAX_SUBQUERY_DEPTH=3
QUERY_EXPLAIN_COST_CEILING=5000000
QUERY_MAX_CONCURRENT_PER_USER=3
PREVIEW_DEFAULT_ROWS=50
EXPORT_BACKGROUND_THRESHOLD_ROWS=5000

# -----------------------------------------------------------------------------
# INFRASTRUCTURE
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# mock  -> seeded local PostgreSQL with planted anomalies (development only)
# live  -> the real operational database above
DATA_SOURCE_MODE=mock

# -----------------------------------------------------------------------------
# AI QUERY ENGINE (Phase 7 -- the platform is fully functional without it)
#
# The model NEVER receives database credentials and NEVER emits SQL. It emits
# the Report IR, which is compiled and validated exactly like a manual report.
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=ollama
# ollama | vllm | openai_compatible | anthropic

AI_ENDPOINT=http://localhost:11434
AI_MODEL=qwen2.5:32b-instruct
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_CONFIDENCE_THRESHOLD=0.7
# Below this, the assistant asks a clarifying question instead of guessing.

# Send sample column VALUES to the model to improve grounding.
# Leave false unless a data-privacy review has approved it.
AI_ALLOW_SAMPLE_VALUES=false

# -----------------------------------------------------------------------------
# ANOMALY ENGINE
# -----------------------------------------------------------------------------
ANOMALY_SCAN_CRON=0 2 * * *
ANOMALY_DEFAULT_TOLERANCE=0.01
ANOMALY_STALE_ORDER_DAYS=7
ANOMALY_MAX_ROWS_PER_RULE=5000

# -----------------------------------------------------------------------------
# EMAIL (optional -- scheduled report delivery and alerts)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
